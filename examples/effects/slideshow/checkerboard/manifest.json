{
  "api": 1,
  "id": "io.github.tqk2811.checkerboard",
  "name": "Checkerboard",
  "version": "1.0.0",
  "description": "A square of the second clip grows from the centre of every cell of a grid until it covers the first. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "cell",
      "type": "float",
      "default": 64,
      "min": 4,
      "max": 1024,
      "description": "Cell size in pixels"
    }
  ],
  "passes": [
    {
      "shader": "shaders/checkerboard.wgsl"
    }
  ]
}
