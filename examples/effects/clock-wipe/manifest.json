{
  "api": 1,
  "id": "io.github.tqk2811.clock-wipe",
  "name": "Clock Wipe",
  "version": "1.0.0",
  "description": "Clock hand sweep from 12 o'clock: the second clip appears behind the hand. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "reverse",
      "type": "bool",
      "default": false,
      "description": "Sweep counterclockwise"
    },
    {
      "name": "center",
      "type": "vec2",
      "default": [
        0.5,
        0.5
      ],
      "description": "Pivot of the hand (0..1)"
    },
    {
      "name": "softness",
      "type": "float",
      "default": 0.01,
      "min": 0,
      "max": 0.25,
      "description": "Edge width, in turns"
    }
  ],
  "passes": [
    {
      "shader": "shaders/clock_wipe.wgsl"
    }
  ]
}
