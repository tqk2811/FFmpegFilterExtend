{
  "api": 1,
  "id": "io.github.tqk2811.rgb-split",
  "name": "RGB Split + Grain",
  "version": "1.0.0",
  "description": "Chromatic aberration with animated film grain, written in GLSL.",
  "inputs": [{ "name": "src" }],
  "params": [
    { "name": "amount", "type": "float", "default": 6, "min": 0, "max": 64, "description": "Channel offset in pixels" },
    { "name": "angle", "type": "float", "default": 0, "description": "Offset direction in degrees" },
    { "name": "grain", "type": "float", "default": 0.08, "min": 0, "max": 1, "description": "Grain strength" }
  ],
  "passes": [{ "shader": "shaders/rgb_split.comp" }]
}
