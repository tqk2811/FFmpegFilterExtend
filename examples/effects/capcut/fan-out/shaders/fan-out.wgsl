fn curve(tab: array<f32, 65>, t: f32) -> f32 {
    let f = clamp(t, 0.0, 1.0) * 64.0;
    let i = u32(floor(f));
    let j = min(i + 1u, 64u);
    return mix(tab[i], tab[j], f - floor(f));
}

fn rot2(v: vec2f, deg: f32) -> vec2f {
    let a = radians(deg);
    let c = cos(a);
    let s = sin(a);
    return vec2f(c * v.x - s * v.y, s * v.x + c * v.y);
}

// Fold coordinates back into 0..1 like a mirrored tile.
fn fold(q: vec2f) -> vec2f {
    return 1.0 - abs((q % vec2f(2.0) + vec2f(2.0)) % vec2f(2.0) - 1.0);
}

fn cell_hash(c: vec2f, seed: f32) -> vec2f {
    var h = fract(c * vec2f(0.1031, 0.1137) + seed * vec2f(0.373, 0.517));
    h += dot(h, h.yx + 33.33);
    return fract((h.xx + h.yx) * h.yx) * 2.0 - 1.0;
}

// Smooth gradient noise squashed to 0..1.
fn ripple_noise(x: vec2f, seed: f32) -> f32 {
    let c = floor(x);
    let f = x - c;
    let w = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    let n00 = dot(cell_hash(c, seed), f);
    let n10 = dot(cell_hash(c + vec2f(1.0, 0.0), seed), f - vec2f(1.0, 0.0));
    let n01 = dot(cell_hash(c + vec2f(0.0, 1.0), seed), f - vec2f(0.0, 1.0));
    let n11 = dot(cell_hash(c + vec2f(1.0, 1.0), seed), f - vec2f(1.0, 1.0));
    let n = mix(mix(n00, n10, w.x), mix(n01, n11, w.x), w.y);
    return 1.0 / (1.0 + exp(-3.0 * n));
}

// uv offset of the rippling warp; `strength` is the warp curve value in percent.
fn ripple(uv: vec2f, strength: f32) -> vec2f {
    let size = globals.size;
    let x = uv * size * (720.0 / min(size.x, size.y)) / RIPPLE_CELL;
    let gain = strength * 0.1;
    let nx = (ripple_noise(x, 2.0) - 0.5) * gain;
    let ny = (ripple_noise(x, 9.0) - 0.5) * gain * size.x / size.y;
    return vec2f(nx, ny) * RIPPLE_RANGE;
}

// A clip spun by `spin` degrees about the centre (y-up pixel space `p`), mirrored at the edges
// and rippled. `which` 0 = first, 1 = second.
fn spun_clip(which: u32, p: vec2f, spin: f32, warp: f32) -> vec3f {
    let size = globals.size;
    let q = rot2(p - size * 0.5, spin) + size * 0.5;
    let uv = fold(vec2f(q.x, size.y - q.y) / size);
    let src = fold(uv + ripple(uv, warp));
    if (which == 0u) { return textureSampleLevel(first, smp, src, 0.0).rgb; }
    return textureSampleLevel(second, smp, src, 0.0).rgb;
}

// Clip smeared along a one-sided arc of `arc` radians around the centre.
fn swirled_clip(which: u32, p: vec2f, spin: f32, warp: f32, arc: f32) -> vec3f {
    let c = globals.size * 0.5;
    var sum = spun_clip(which, p, spin, warp);
    var n = 1.0;
    for (var k = 1; k <= SWIRL_TAPS; k++) {
        let q = c + rot2(p - c, -degrees(arc) * f32(k) / f32(SWIRL_TAPS));
        if (all(q >= vec2f(0.0)) && all(q <= globals.size)) {
            sum += spun_clip(which, q, spin, warp);
            n += 1.0;
        }
    }
    return sum / n;
}

// Coverage of a wedge that opens from the start angle as `open` falls from 1 to 0.
fn wedge(d: vec2f, start_deg: f32, open: f32) -> f32 {
    let a = rot2(d, 270.0 - start_deg);
    let b = (atan2(a.y, a.x) + PI) / TAU;
    let s = sin(radians(90.0 - start_deg));
    let lead = abs(s * cos(radians(90.0 - start_deg))) * EDGE_FEATHER + 1e-4;
    let e = radians(90.0 - start_deg) + open * TAU;
    let trail = abs(sin(e) * cos(e)) * EDGE_FEATHER + 1e-4;
    let m = (1.0 - smoothstep(0.0, lead, b)) + smoothstep(open - trail, open, b);
    return clamp(m, 0.0, 1.0);
}

// Same wedge with its edges blurred by `soft` pixels, for the drop shadow.
fn soft_wedge(d: vec2f, start_deg: f32, open: f32, soft: f32) -> f32 {
    if (open >= 1.0) { return 0.0; }
    let a = rot2(d, 270.0 - start_deg);
    let b = (atan2(a.y, a.x) + PI) / TAU;
    let r = length(d);
    let to_start = (b - open) * TAU;
    let to_end = (1.0 - b) * TAU;
    let inside = b >= open;
    var dist = r * sin(min(min(abs(to_start), abs(to_end)), PI * 0.5));
    if (!inside) {
        dist = -r * sin(min(min(abs(to_start), abs(b * TAU)), PI * 0.5));
    }
    return smoothstep(-soft, soft, dist);
}

// Picture before the lens bend, at y-up pixel position `p`.
fn scene(p: vec2f, t: f32) -> vec3f {
    let mid = globals.size * 0.5;
    let d = vec2f(p.x - mid.x, mid.y - p.y);
    let arc = curve(B_SWIRL, t) * SWIRL_TO_TURNS * TAU;
    var color = swirled_clip(0u, p, curve(A_SPIN, t), curve(A_WARP, t), arc);

    color = mix(color, GOLD, wedge(d, curve(GOLD_TURN, t), curve(GOLD_OPEN, t) * 0.01));
    color = mix(color, vec3f(1.0), wedge(d, curve(WHITE_TURN, t), curve(WHITE_OPEN, t) * 0.01));

    let b_open = curve(B_OPEN, t) * 0.01;
    let b_turn = curve(B_TURN, t);
    let fade = mix(0.2, 1.0, clamp((t * 38.0 / 30.0 - 1.0) / (24.0 / 30.0 - 1.0), 0.0, 1.0));
    let soft = curve(SHADE_SOFT, t) / 13.0 * 20.0 * fade * globals.size.y / 720.0 + 0.5;
    let shade = soft_wedge(d, b_turn, b_open, soft) * curve(SHADE_ALPHA, t) * 0.005;
    color = color * (1.0 - shade);

    let cover = wedge(d, b_turn, b_open);
    if (cover > 0.0) {
        let sum = swirled_clip(1u, p, curve(B_SPIN, t), curve(B_WARP, t), arc);
        color = mix(color, sum, cover);
    }
    return color;
}

@compute @workgroup_size(8, 8)
fn main(@builtin(global_invocation_id) id: vec3u) {
    if (!gpufx_in_bounds(id)) { return; }
    let t = clamp(params.progress, 0.0, 1.0);
    let size = globals.size;
    let uv = gpufx_uv(id);

    // Barrel bend that peaks mid-way: pull samples outward with distance from the centre.
    let k = curve(LENS_FOV, t) / 180.0;
    let bend = 22.759 * pow(k, 3.167) + 0.431 * k;
    let v = (uv - 0.5) * vec2f(1.0, size.y / size.x);
    let grow = 1.0 / max(1.0 - bend * dot(v, v), 0.05);
    let src = (uv - 0.5) * grow + 0.5;

    let p = vec2f(src.x, 1.0 - src.y) * size;
    gpufx_write(id, vec4f(scene(p, t), 1.0));
}
