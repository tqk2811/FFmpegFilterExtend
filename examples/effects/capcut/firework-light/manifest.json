{
  "api": 1,
  "id": "io.github.tqk2811.capcut.firework-light",
  "name": "Firework Light",
  "version": "1.0.0",
  "description": "A burst of warm sparkles rises from the bottom and floods the frame while a growing bokeh blur hides the cut to the second clip. Recreation of the CapCut \"Firework Light\" transition. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    }
  ],
  "passes": [
    {
      "shader": "shaders/sparkle.wgsl",
      "inputs": ["first", "second"],
      "output": "lit"
    },
    {
      "shader": "shaders/blur-v.wgsl",
      "inputs": ["lit"],
      "output": "soft_v"
    },
    {
      "shader": "shaders/blur-h.wgsl",
      "inputs": ["soft_v"],
      "output": "soft"
    },
    {
      "shader": "shaders/bokeh.wgsl",
      "inputs": ["soft"],
      "output": "bokeh"
    },
    {
      "shader": "shaders/finish.wgsl",
      "inputs": ["first", "second", "lit", "bokeh"]
    }
  ]
}
