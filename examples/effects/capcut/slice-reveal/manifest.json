{
  "api": 1,
  "id": "io.github.tqk2811.capcut.slice-reveal",
  "name": "Slice Reveal",
  "version": "1.0.0",
  "description": "The first clip is cut along a diagonal and its two halves slide apart sideways with motion blur and soft drop shadows, revealing the second clip. Recreation of the CapCut \"Slice Reveal\" transition. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    }
  ],
  "passes": [
    {
      "shader": "shaders/slice-left.wgsl",
      "inputs": [
        "first"
      ],
      "output": "left"
    },
    {
      "shader": "shaders/slice-right.wgsl",
      "inputs": [
        "first"
      ],
      "output": "right"
    },
    {
      "shader": "shaders/shadow.wgsl",
      "inputs": [
        "left",
        "right"
      ],
      "output": "shade_x"
    },
    {
      "shader": "shaders/final.wgsl",
      "inputs": [
        "first",
        "second",
        "left",
        "right",
        "shade_x"
      ]
    }
  ]
}
