{
  "api": 1,
  "id": "io.github.tqk2811.capcut.dazzle-pulse",
  "name": "Dazzle Pulse",
  "version": "1.0.0",
  "description": "A bright pulse: the frame swells, ripples, flares in exposure and shakes with a zoom blur and a colour split, cutting to the second clip at the peak. Recreation of the CapCut \"Dazzle Pulse\" transition. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    }
  ],
  "passes": [
    {
      "shader": "shaders/zoom.wgsl",
      "inputs": [
        "first",
        "second"
      ],
      "output": "zoomed"
    },
    {
      "shader": "shaders/warp.wgsl",
      "inputs": [
        "zoomed"
      ],
      "output": "warped"
    },
    {
      "shader": "shaders/shake.wgsl",
      "inputs": [
        "warped",
        "first",
        "second"
      ]
    }
  ]
}
