// Side cards and shadow live until 1.2667 s of scene time.
const BACK_END: f32 = 1.2666667;

@compute @workgroup_size(8, 8)
fn main(@builtin(global_invocation_id) id: vec3u) {
    if (!gpufx_in_bounds(id)) { return; }
    let uv = gpufx_uv(id);
    let t = scene_time();
    if (idle() || t >= BACK_END) { gpufx_write(id, vec4f(0.0)); return; }
    let rig = at(PARENT_K, t);
    let fade = at(FADE_A_K, t);
    // Card 1 (upper left): darkened first clip cut out by a card shape.
    let s1 = card_hit(uv, rig, at(CARD1_SHAPE_K, t), 0.0, vec2f(105.0, 184.5), vec2f(336.0, 252.0));
    let i1 = card_hit(uv, rig, at(CARD1_IMG_K, t), 0.0, vec2f(168.8, 188.0), vec2f(336.0, 252.0));
    var acc = darken(card_texel(first, i1)) * (fade.x * 0.01) * (s1.z * fade.x * 0.01);
    // Card 2 (lower right).
    let s2 = card_hit(uv, rig, at(CARD2_SHAPE_K, t), 0.0, vec2f(105.0, 184.5), vec2f(336.0, 252.0));
    let i2 = card_hit(uv, rig, at(CARD2_IMG_K, t), 0.0, vec2f(168.8, 188.0), vec2f(336.0, 252.0));
    acc = over(darken(card_texel(first, i2)) * (fade.w * 0.01) * (s2.z * fade.w * 0.01), acc);
    // Black shadow card offset behind the first clip.
    let sh = card_hit(uv, rig, at(SHADOW_K, t), 0.0, vec2f(100.0, 100.0), vec2f(336.0, 252.0));
    acc = over(vec4f(0.0, 0.0, 0.0, sh.z * fade.y * 0.01), acc);
    gpufx_write(id, acc);
}
