const DIM_START: f32 = 1.1666667;
const INCOMING_START: f32 = 1.0;

@compute @workgroup_size(8, 8)
fn main(@builtin(global_invocation_id) id: vec3u) {
    if (!gpufx_in_bounds(id)) { return; }
    let uv = gpufx_uv(id);
    let t = scene_time();
    if (idle()) { gpufx_write(id, vec4f(0.0)); return; }
    var acc = textureSampleLevel(middle, smp, uv, 0.0);
    if (t >= DIM_START) {
        // Blurred, darkened copy of the layers so far, over their sharp copy.
        acc = over(from_half(middle_soft, uv), acc);
    }
    if (t >= INCOMING_START) {
        let rig = at(PARENT_K, t);
        let h = card_hit(uv, rig, at(FRONT_B_K, t), 180.0, vec2f(100.0, 100.0), vec2f(336.0, 252.0));
        acc = over(card_texel(second, h) * (at(FADE_B_K, t).z * 0.01), acc);
    }
    gpufx_write(id, acc);
}
