{
  "api": 1,
  "id": "io.github.tqk2811.capcut.stack-rotate",
  "name": "Stack & Rotate",
  "version": "1.0.0",
  "description": "The first clip shrinks into a tilted card among blurred side cards while the whole stack rolls half a turn, a blur and twirl pulse hides the swap, and the second clip card settles back to full frame. Recreation of the CapCut \"Stack & Rotate\" transition. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    }
  ],
  "passes": [
    {
      "shader": "shaders/back.wgsl",
      "inputs": [
        "first"
      ],
      "output": "back"
    },
    {
      "shader": "shaders/back-blur-x.wgsl",
      "inputs": [
        "back"
      ],
      "output": "back_blur_x"
    },
    {
      "shader": "shaders/back-blur-y.wgsl",
      "inputs": [
        "back_blur_x"
      ],
      "output": "back_soft"
    },
    {
      "shader": "shaders/middle.wgsl",
      "inputs": [
        "back_soft",
        "back",
        "first",
        "second"
      ],
      "output": "middle"
    },
    {
      "shader": "shaders/middle-blur-x.wgsl",
      "inputs": [
        "middle"
      ],
      "output": "middle_blur_x"
    },
    {
      "shader": "shaders/middle-blur-y.wgsl",
      "inputs": [
        "middle_blur_x"
      ],
      "output": "middle_soft"
    },
    {
      "shader": "shaders/front.wgsl",
      "inputs": [
        "middle_soft",
        "middle",
        "second"
      ],
      "output": "stacked"
    },
    {
      "shader": "shaders/haze-x.wgsl",
      "inputs": [
        "stacked"
      ],
      "output": "haze_x"
    },
    {
      "shader": "shaders/haze-y.wgsl",
      "inputs": [
        "haze_x"
      ],
      "output": "haze"
    },
    {
      "shader": "shaders/twirl.wgsl",
      "inputs": [
        "haze",
        "stacked",
        "first",
        "second"
      ]
    }
  ]
}
