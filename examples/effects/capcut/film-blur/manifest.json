{
  "api": 1,
  "id": "io.github.tqk2811.capcut.film-blur",
  "name": "Film Blur",
  "version": "1.0.0",
  "description": "Hard cut hidden under a burst of warm, high-contrast light leak screened over the picture. Recreation of the CapCut \"Film Blur\" transition. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    }
  ],
  "passes": [
    {
      "shader": "shaders/look.wgsl",
      "inputs": [
        "first",
        "second"
      ],
      "output": "look"
    },
    {
      "shader": "shaders/crisp.wgsl",
      "inputs": [
        "look"
      ],
      "output": "crisp"
    },
    {
      "shader": "shaders/film-blur.wgsl",
      "inputs": [
        "first",
        "second",
        "crisp"
      ]
    }
  ]
}
