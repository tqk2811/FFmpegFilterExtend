fn surface(base: i32, q: vec2f) -> f32 {
    let x = q.x;
    let y = q.y;
    return LIGHT[base] + y * (LIGHT[base + 1] + y * (LIGHT[base + 2] + y * LIGHT[base + 3]))
        + x * (LIGHT[base + 4] + y * (LIGHT[base + 5] + y * LIGHT[base + 6]))
        + x * x * (LIGHT[base + 7] + y * LIGHT[base + 8] + x * LIGHT[base + 9]);
}

// Additive light colour of one key; keys outside the table are dark.
fn light_key(key: i32, q: vec2f) -> vec3f {
    if (key < 0 || key >= KEY_COUNT) { return vec3f(0.0); }
    let base = key * 30;
    return clamp(vec3f(surface(base, q), surface(base + 10, q), surface(base + 20, q)), vec3f(0.0), vec3f(1.0));
}

fn light_time(p: f32) -> f32 {
    let s = (p - TIMING_START) / TIMING_STEP;
    if (s <= 0.0) { return TIMING[0] + s * (TIMING[1] - TIMING[0]); }
    if (s >= 5.0) { return TIMING[5] + (s - 5.0) * (TIMING[5] - TIMING[4]); }
    let i = i32(floor(s));
    return mix(TIMING[i], TIMING[i + 1], s - f32(i));
}

@compute @workgroup_size(8, 8)
fn main(@builtin(global_invocation_id) id: vec3u) {
    if (!gpufx_in_bounds(id)) { return; }
    let uv = gpufx_uv(id);
    // Exact clips at the ends, so cutting in and out of the transition never jumps.
    if (params.progress <= 0.0) { gpufx_write(id, vec4f(textureSampleLevel(first, smp, uv, 0.0).rgb, 1.0)); return; }
    if (params.progress >= 1.0) { gpufx_write(id, vec4f(textureSampleLevel(second, smp, uv, 0.0).rgb, 1.0)); return; }
    let p = params.progress;
    var base: vec3f;
    if (p < CUT) {
        base = textureSampleLevel(first, smp, uv, 0.0).rgb;
    } else {
        base = textureSampleLevel(second, smp, uv, 0.0).rgb;
    }
    // The light is a square layer that covers the frame, slightly overscanned.
    let q = (uv - 0.5) * 2.0 * globals.size / max(globals.size.x, globals.size.y) / 1.0195;
    let k = light_time(p);
    let k0 = floor(k);
    let light = mix(light_key(i32(k0), q), light_key(i32(k0) + 1, q), k - k0);
    gpufx_write(id, vec4f(base + light, 1.0));
}
