{
  "api": 1,
  "id": "io.github.tqk2811.capcut.shaky-inhale",
  "name": "Shaky Inhale",
  "version": "1.0.0",
  "description": "Suck the first input inward under a shaking zoom blur and a white glow, then burst the second one out of a fisheye. Recreation of the CapCut \"Shaky Inhale\" transition. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    }
  ],
  "passes": [
    {
      "shader": "shaders/scene.wgsl",
      "inputs": ["first", "second"],
      "output": "streaks"
    },
    {
      "shader": "shaders/glow-h.wgsl",
      "inputs": ["streaks"],
      "output": "glow_h"
    },
    {
      "shader": "shaders/glow-v.wgsl",
      "inputs": ["streaks", "glow_h"]
    }
  ]
}
