{
  "api": 1,
  "id": "io.github.tqk2811.capcut.heat-flash",
  "name": "Heat Flash",
  "version": "1.0.0",
  "description": "The first clip blooms into a warm orange glow while a flickering film-burn flash washes over the frame, then the second clip emerges as the glow fades. Recreation of the CapCut \"Heat Flash\" transition. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    }
  ],
  "passes": [
    {
      "shader": "shaders/bright.wgsl",
      "inputs": ["first", "second"],
      "output": "bright"
    },
    {
      "shader": "shaders/glow-h.wgsl",
      "inputs": ["bright"],
      "output": "glow_h"
    },
    {
      "shader": "shaders/glow-v.wgsl",
      "inputs": ["glow_h"],
      "output": "glow"
    },
    {
      "shader": "shaders/finish.wgsl",
      "inputs": ["first", "second", "glow"]
    }
  ]
}
