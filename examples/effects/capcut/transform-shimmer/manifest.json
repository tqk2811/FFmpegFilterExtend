{
  "api": 1,
  "id": "io.github.tqk2811.capcut.transform-shimmer",
  "name": "Transform Shimmer",
  "version": "1.0.0",
  "description": "Fade to the second clip through a soft blur that swells and clears again while golden sparkles drift over the frame. Recreation of the CapCut \"Transform Shimmer\" transition. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    }
  ],
  "passes": [
    {
      "shader": "shaders/fade.wgsl",
      "inputs": ["first", "second"],
      "output": "faded"
    },
    {
      "shader": "shaders/blur-h.wgsl",
      "inputs": ["faded"],
      "output": "blur_h"
    },
    {
      "shader": "shaders/finish.wgsl",
      "inputs": ["first", "second", "blur_h"]
    }
  ]
}
