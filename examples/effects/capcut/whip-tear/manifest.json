{
  "api": 1,
  "id": "io.github.tqk2811.capcut.whip-tear",
  "name": "Whip Tear",
  "version": "1.0.0",
  "description": "The first clip tears down the middle and the two halves bow and whip off to the sides with motion blur and a soft shadow, uncovering the second clip. Recreation of the CapCut \"Whip Tear\" transition. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    }
  ],
  "passes": [
    {
      "shader": "shaders/tear.wgsl",
      "inputs": ["first"],
      "output": "torn"
    },
    {
      "shader": "shaders/shadow-h.wgsl",
      "inputs": ["torn"],
      "output": "shadow_h"
    },
    {
      "shader": "shaders/shadow-v.wgsl",
      "inputs": ["shadow_h"],
      "output": "shadow"
    },
    {
      "shader": "shaders/finish.wgsl",
      "inputs": ["first", "second", "torn", "shadow"]
    }
  ]
}
