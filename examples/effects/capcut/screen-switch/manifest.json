{
  "api": 1,
  "id": "io.github.tqk2811.capcut.screen-switch",
  "name": "Screen Switch",
  "version": "1.0.0",
  "description": "The first clip shrinks into a rounded, lens-curved card that flies up out of frame with motion blur while the second card flies in from below and settles to full screen. Recreation of the CapCut \"Screen Switch\" transition. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    }
  ],
  "passes": [
    {
      "shader": "shaders/card-first.wgsl",
      "inputs": [
        "first"
      ],
      "output": "card_first"
    },
    {
      "shader": "shaders/card-second.wgsl",
      "inputs": [
        "second"
      ],
      "output": "card_second"
    },
    {
      "shader": "shaders/screen-switch.wgsl",
      "inputs": [
        "first",
        "second",
        "card_first",
        "card_second"
      ]
    }
  ]
}
