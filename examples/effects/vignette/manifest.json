{
  "api": 1,
  "id": "io.github.tqk2811.vignette",
  "name": "Vignette",
  "version": "1.0.0",
  "description": "Darkens (or tints) the frame edges.",
  "inputs": [{ "name": "src" }],
  "params": [
    { "name": "strength", "type": "float", "default": 0.6, "min": 0, "max": 1, "description": "How strong the vignette is" },
    { "name": "radius", "type": "float", "default": 0.75, "min": 0, "max": 1.5, "description": "Where the darkening starts" },
    { "name": "color", "type": "color", "default": "#000000", "description": "Vignette color" }
  ],
  "passes": [{ "shader": "shaders/vignette.wgsl" }]
}
