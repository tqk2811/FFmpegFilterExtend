{
  "api": 1,
  "id": "io.github.tqk2811.zoom-transition",
  "name": "Zoom Transition",
  "version": "1.0.0",
  "description": "The first clip zooms in toward a point and fades into the second. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "zoom",
      "type": "float",
      "default": 3,
      "min": 1,
      "max": 16,
      "description": "Magnification of the first clip at the end"
    },
    {
      "name": "center",
      "type": "vec2",
      "default": [
        0.5,
        0.5
      ],
      "description": "Point to zoom into (0..1)"
    }
  ],
  "passes": [
    {
      "shader": "shaders/zoom_transition.wgsl"
    }
  ]
}
