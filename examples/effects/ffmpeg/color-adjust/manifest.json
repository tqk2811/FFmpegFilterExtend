{
  "api": 1,
  "id": "io.github.tqk2811.color-adjust",
  "name": "Color Adjust",
  "version": "1.0.0",
  "description": "Brightness, contrast, saturation, gamma, hue and white balance in one pass.",
  "inputs": [
    {
      "name": "src"
    }
  ],
  "params": [
    {
      "name": "brightness",
      "type": "float",
      "default": 0,
      "min": -1,
      "max": 1,
      "description": "Added to every channel"
    },
    {
      "name": "contrast",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 4,
      "description": "1 = unchanged"
    },
    {
      "name": "saturation",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 4,
      "description": "0 = gray, 1 = unchanged"
    },
    {
      "name": "gamma",
      "type": "float",
      "default": 1,
      "min": 0.1,
      "max": 10,
      "description": "Values above 1 brighten mid tones"
    },
    {
      "name": "hue",
      "type": "float",
      "default": 0,
      "min": -180,
      "max": 180,
      "description": "Hue rotation in degrees"
    },
    {
      "name": "temperature",
      "type": "float",
      "default": 0,
      "min": -1,
      "max": 1,
      "description": "Negative = cooler (blue), positive = warmer (orange)"
    },
    {
      "name": "tint",
      "type": "float",
      "default": 0,
      "min": -1,
      "max": 1,
      "description": "Negative = green, positive = magenta"
    }
  ],
  "passes": [
    {
      "shader": "shaders/color_adjust.wgsl"
    }
  ]
}
