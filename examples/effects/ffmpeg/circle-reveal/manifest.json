{
  "api": 1,
  "id": "io.github.tqk2811.circle-reveal",
  "name": "Circle Reveal",
  "version": "1.0.0",
  "description": "Iris transition: the second clip appears in a growing circle. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "center",
      "type": "vec2",
      "default": [
        0.5,
        0.5
      ],
      "description": "Circle center (0..1)"
    },
    {
      "name": "softness",
      "type": "float",
      "default": 0.02,
      "min": 0,
      "max": 0.5,
      "description": "Edge width"
    }
  ],
  "passes": [
    {
      "shader": "shaders/circle_reveal.wgsl"
    }
  ]
}
